amends "package://github.com/jdx/hk/releases/download/v2.0.0/hk@2.0.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.0.0/hk@2.0.0#/Builtins.pkl"

min_hk_version = "2.0.0"

fail_fast = false

steps {
  ["rustfmt"] = Builtins.rustfmt
  ["clippy"] = new Step {
    glob = List("**/*.rs")
    check = new CommandSpec {
      command = new Command { argv = List("cargo", "clippy", "--all-targets", "--", "-D", "warnings") }
      effect = "write"
    }
  }
}

hooks {
  ["commit-msg"] {
    steps {
      ["check_conventional_commit"] = Builtins.check_conventional_commit
    }
  }
}
