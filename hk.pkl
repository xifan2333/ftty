amends "package://github.com/jdx/hk/releases/download/v2.0.0/hk@2.0.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.0.0/hk@2.0.0#/Builtins.pkl"

min_hk_version = "2.0.0"

fail_fast = false

steps {
  ["rustfmt"] = Builtins.rustfmt
  ["clippy"] = new Step {
    glob = List("**/*.rs")
    check = new CommandSpec {
      command = new Command { argv = List("cargo", "clippy", "--all-targets", "--", "-D", "warnings") }
      effect = "write"
    }
  }

  ["check-ast"] {
    glob = List("src/**/*.rs")
    check = "ast-grep scan --error {{files}}"
  }

  ["check-complexity"] {
    glob = List("src/**/*.rs")
    check = "bash scripts/check-complexity.sh"
  }

  ["check-dup"] {
    glob = List("src/**/*.rs")
    check = "jscpd --config .jscpd.json"
  }

  ["check-typos"] {
    glob = List("src/**", "doc/**", "Cargo.toml", "scripts/**")
    check = "typos"
  }

  ["trailing-whitespace"] = Builtins.trailing_whitespace
  ["newlines"] = Builtins.newlines
  ["check-merge-conflict"] = Builtins.check_merge_conflict
  ["detect-private-key"] = Builtins.detect_private_key
  ["check-case-conflict"] = Builtins.check_case_conflict
  ["check-symlinks"] = Builtins.check_symlinks
}

hooks {
  ["commit-msg"] {
    steps {
      ["check_conventional_commit"] = Builtins.check_conventional_commit
    }
  }
}
